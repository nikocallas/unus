# Unus — placeholder configuration. Copy to .env.local (ignored) and fill in locally, or set these in
# the Vercel project. Never commit real values. With none of these set, Unus still runs end to end on
# its deterministic fallbacks, and every fallback is labelled in the UI and in `npm run demo:run`.

# Stage 1 extraction: Muse Spark Open on Baseten (model meta-models/muse-spark-open-1026)
BASETEN_API_KEY=replace-me
# Optional; defaults to Baseten's OpenAI-compatible endpoint.
BASETEN_BASE_URL=https://inference.baseten.co/v1

# Stage 2 normalization + review: Muse Spark on the Meta Model API.
META_MODEL_API_KEY=replace-me
META_MODEL_API_BASE_URL=https://api.meta.ai
# Muse Spark model id. Use the Standard id (e.g. muse-spark-1.3) — never a "-contributor" id; the client refuses those.
META_SPARK_MODEL=muse-spark-1.3
# Wire format of the endpoint: anthropic (POST {base}/v1/messages) or openai (POST {base}/chat/completions).
META_MODEL_API_FORMAT=anthropic
# Required attestation. Unus refuses to call the Meta Model API unless this is exactly "standard".
# Never use Contributor tier (it permits training on prompts/completions).
META_MODEL_API_TIER=standard

# Record Atlas: Muse Image on the Meta Model API (same key and tier attestation as above).
META_IMAGE_API_URL=https://api.meta.ai/v1/images/generations
META_IMAGE_MODEL=muse-image-1.0

# Run log (optional, server-only). Fresh Unus Supabase project; table from supabase/migrations/.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
